      "description": "Задача #10: POST /auth/register и POST /auth/login.",
      "item": [
        {
          "name": "REG-01 Корректная регистрация",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 201 или 501', () => pm.expect(pm.response.code).to.be.oneOf([201, 501]));",
                  "pm.test('Ответ в JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('json'));",
                  "pm.test('Пароль не возвращается в ответе', () => pm.expect(pm.response.text()).to.not.include('secret123'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ivan@example.com\",\n  \"password\": \"secret123\",\n  \"firstName\": \"Иван\",\n  \"lastName\": \"Иванов\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Все поля корректны. Сейчас 501 (бизнес-логика в #12), после #12 ожидается 201 и userId в ответе."
          }
        },
